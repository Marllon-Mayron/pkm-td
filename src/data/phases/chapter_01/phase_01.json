            },
            {
                "trigger_type": "custom",
                "time_value": 0.0,
                "wave_index": 0,
                "wave_state": "wave_start",
                "custom_condition": "colocou_pokemon",
                "events": [
                    {
                        "event_type": "message",
                        "delay": 0.0,
                        "pause_game": true,
                        "message_text": "Perfeito! Você também consegue arrastar o pokemon de um circulo para outro. Em cima do seu pokémon, você consegue ver a vida dele, ele parece estar um pouco machucado... que tal dar uma potion para ele? É só arrastar da sua bolsa e coloca-la em cima do seu pokemon.",
                        "speaker_name": "Professor Carvalho",
                        "speaker_sprite_path": "C:/Users/Marllon/PycharmProjects/pkm-td/res/PokemonSprites/characters/introOak.png",
                        "action_label": "Entendi!",
                        "action_trigger": ""
                    }
                ]
            },
            {
                "trigger_type": "custom",
                "time_value": 0.0,
                "wave_index": 0,
                "wave_state": "wave_start",
                "custom_condition": "curou_pokemon",
                "events": [
                    {
                        "event_type": "message",
                        "delay": 0.0,
                        "pause_game": true,
                        "message_text": "Muito melhor! Que tal dar uma olhadinha nos ataques disponiveis pro seu pokemon? É só clicar na imagem do seu pokemon no time, mas não esqueça que o painel só abre se seu pokemon estiver posicionado no mapa!",
                        "speaker_name": "Professor Carvalho",
                        "speaker_sprite_path": "C:/Users/Marllon/PycharmProjects/pkm-td/res/PokemonSprites/characters/introOak.png",
                        "action_label": "Vou olhar",
                        "action_trigger": ""
                    }
                ]
            },
            {
                "trigger_type": "custom",
