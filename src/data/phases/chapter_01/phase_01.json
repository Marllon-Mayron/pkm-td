                        "delay": 0.0,
                        "pause_game": true,
                        "message_text": "É um bom começo... sempre que possivel verifique os PPs e Prioridade de ataque do seu pokemon para fortalecer suas estratégias. Vamos começar a batalha, feche a tela e se prepare!",
                        "speaker_name": "Professor Venossauro",
                        "speaker_sprite_path": "C:/Users/Marllon/PycharmProjects/pkm-td/res/PokemonSprites/characters/introOak.png",
