                "events": [
                    {
                        "event_type": "message",
                        "delay": 0.0,
                        "pause_game": true,
                        "message_text": "Seja bem-vindo! Esse é o pokemon tower defese! Já vi que escolheu seu primeiro pokemon, vamos coloca-lo no mapa! Arraste a imagem do seu pokemon que está no seu time, e coloque no circulo no mapa.",
