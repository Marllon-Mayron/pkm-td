{
  "schema_version": 1,
  "name": "thunderstorm",
  "category": "weather",
  "description": "Tempestade — chuva pesada + relâmpagos piscando",
  "scale_mult": 1.0, "anchor_mode": "center", "world_scaled": false,
  "fps": 60, "duration_frames": 600, "loop": true, "loop_count": 0,
  "anchor": "screen", "space": "screen",
  "world_offset": { "x": 0, "y": 0 }, "screen_offset": { "x": 0, "y": 0 },
  "sound": null,
  "layers": [
    {
      "id": "storm_tint", "type": "filter", "z": 0, "blend": "normal",
      "color": "#1E2240", "alpha": 150,
      "fade_in_frames": 0, "fade_out_frames": 0
    },

    {
      "id": "rain_back", "type": "emitter", "image": "_shared/raindrop_16.png",
      "z": 2, "blend": "normal", "pivot": "center", "offset": { "x": 0, "y": 0 },
      "visible_frames": [0, 600],
      "emitter": {
        "spawn_area": { "x": -750, "y": -450, "w": 1500, "h": 100 },
        "spawn_rate": 100.0, "max_particles": 320,
        "lifetime": [1.1, 1.7],
        "velocity": { "x": [-70, -30], "y": [720, 900] },
        "gravity": 0.0, "scale": [0.6, 0.9], "alpha": [140, 200],
        "rotation_speed": [0, 0], "fade_out": false,
        "tint_options": ["#A0C8FF", "#C0E0FF"]
      }
    },
    {
      "id": "rain_front", "type": "emitter", "image": "_shared/raindrop_16.png",
      "z": 4, "blend": "normal", "pivot": "center", "offset": { "x": 0, "y": 0 },
      "visible_frames": [0, 600],
      "emitter": {
        "spawn_area": { "x": -750, "y": -450, "w": 1500, "h": 100 },
        "spawn_rate": 50.0, "max_particles": 160,
        "lifetime": [0.9, 1.4],
        "velocity": { "x": [-90, -40], "y": [850, 1050] },
        "gravity": 0.0, "scale": [0.9, 1.3], "alpha": [200, 255],
        "rotation_speed": [0, 0], "fade_out": false,
        "tint_options": ["#FFFFFF", "#C0E0FF"]
      }
    },
    {
      "id": "splashes", "type": "emitter", "image": "_shared/splash_16.png",
      "z": 3, "blend": "normal", "pivot": "center", "offset": { "x": 0, "y": 330 },
      "visible_frames": [0, 600],
      "emitter": {
        "spawn_area": { "x": -700, "y": -20, "w": 1400, "h": 40 },
        "spawn_rate": 45.0, "max_particles": 70,
        "lifetime": [0.3, 0.5],
        "velocity": { "x": [-120, 120], "y": [-160, -90] },
        "gravity": 380.0, "scale": [0.6, 1.0], "alpha": [200, 255],
        "rotation_speed": [-150, 150], "fade_out": true,
        "tint_options": ["#C0E0FF", "#FFFFFF"]
      }
    },

    {
      "id": "flash_1", "type": "sprite", "image": "_shared/glow_32.png",
      "z": 30, "blend": "add", "pivot": "center", "offset": { "x": 0, "y": 0 },
      "visible_frames": [120, 145],
      "keyframes": [
        { "f": 120, "x": 0, "y": 0, "scale": 55, "alpha": 0,   "tint": "#FFFFFF" },
        { "f": 123, "x": 0, "y": 0, "scale": 55, "alpha": 250, "tint": "#FFFFFF" },
        { "f": 126, "x": 0, "y": 0, "scale": 55, "alpha": 40,  "tint": "#FFFFFF" },
        { "f": 129, "x": 0, "y": 0, "scale": 55, "alpha": 220, "tint": "#FFFFFF" },
        { "f": 133, "x": 0, "y": 0, "scale": 55, "alpha": 90,  "tint": "#FFFFFF" },
        { "f": 138, "x": 0, "y": 0, "scale": 55, "alpha": 200, "tint": "#FFFFFF" },
        { "f": 145, "x": 0, "y": 0, "scale": 55, "alpha": 0,   "tint": "#FFFFFF" }
      ],
      "easing": "linear",
      "frame_width": 0, "frame_height": 0, "frame_index": 0
    },
    {
      "id": "flash_2", "type": "sprite", "image": "_shared/glow_32.png",
      "z": 30, "blend": "add", "pivot": "center", "offset": { "x": 0, "y": 0 },
      "visible_frames": [380, 410],
      "keyframes": [
        { "f": 380, "x": 0, "y": 0, "scale": 55, "alpha": 0,   "tint": "#FFFFFF" },
        { "f": 383, "x": 0, "y": 0, "scale": 55, "alpha": 240, "tint": "#FFFFFF" },
        { "f": 387, "x": 0, "y": 0, "scale": 55, "alpha": 60,  "tint": "#FFFFFF" },
        { "f": 390, "x": 0, "y": 0, "scale": 55, "alpha": 210, "tint": "#FFFFFF" },
        { "f": 395, "x": 0, "y": 0, "scale": 55, "alpha": 80,  "tint": "#FFFFFF" },
        { "f": 400, "x": 0, "y": 0, "scale": 55, "alpha": 180, "tint": "#FFFFFF" },
        { "f": 410, "x": 0, "y": 0, "scale": 55, "alpha": 0,   "tint": "#FFFFFF" }
      ],
      "easing": "linear",
      "frame_width": 0, "frame_height": 0, "frame_index": 0
    },
    {
      "id": "flash_3", "type": "sprite", "image": "_shared/glow_32.png",
      "z": 30, "blend": "add", "pivot": "center", "offset": { "x": 0, "y": 0 },
      "visible_frames": [520, 545],
      "keyframes": [
        { "f": 520, "x": 0, "y": 0, "scale": 55, "alpha": 0,   "tint": "#FFFFFF" },
        { "f": 523, "x": 0, "y": 0, "scale": 55, "alpha": 255, "tint": "#FFFFFF" },
        { "f": 527, "x": 0, "y": 0, "scale": 55, "alpha": 50,  "tint": "#FFFFFF" },
        { "f": 530, "x": 0, "y": 0, "scale": 55, "alpha": 230, "tint": "#FFFFFF" },
        { "f": 536, "x": 0, "y": 0, "scale": 55, "alpha": 100, "tint": "#FFFFFF" },
        { "f": 545, "x": 0, "y": 0, "scale": 55, "alpha": 0,   "tint": "#FFFFFF" }
      ],
      "easing": "linear",
      "frame_width": 0, "frame_height": 0, "frame_index": 0
    }
  ],
  "default_binding": { "trigger": "weather.thunderstorm.enter" }
}