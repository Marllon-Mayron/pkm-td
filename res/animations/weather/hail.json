{
  "schema_version": 1,
  "name": "hail",
  "category": "weather",
  "description": "Granizo — pedras rápidas + neve de fundo",
  "scale_mult": 1.0, "anchor_mode": "center", "world_scaled": false,
  "fps": 60, "duration_frames": 300, "loop": true, "loop_count": 0,
  "anchor": "screen", "space": "screen",
  "world_offset": { "x": 0, "y": 0 }, "screen_offset": { "x": 0, "y": 0 },
  "sound": null,
  "layers": [
    {
      "id": "hail_tint", "type": "filter", "z": 0, "blend": "normal",
      "color": "#A0D2F0", "alpha": 100,
      "fade_in_frames": 40, "fade_out_frames": 0
    },
    {
      "id": "hail_snow", "type": "emitter", "image": "_shared/snowflake_16.png",
      "z": 2, "blend": "normal", "pivot": "center", "offset": { "x": 0, "y": 0 },
      "visible_frames": [0, 300],
      "emitter": {
        "spawn_area": { "x": -700, "y": -450, "w": 1400, "h": 100 },
        "spawn_rate": 20.0, "max_particles": 80,
        "lifetime": [2.5, 4.0],
        "velocity": { "x": [-30, 30], "y": [120, 200] },
        "gravity": 0.0, "scale": [0.5, 0.8], "alpha": [150, 210],
        "rotation_speed": [-45, 45], "fade_out": false,
        "tint_options": ["#E0F0FF", "#FFFFFF"]
      }
    },
    {
      "id": "hailstones", "type": "emitter", "image": "_shared/hailstone_16.png",
      "z": 4, "blend": "normal", "pivot": "center", "offset": { "x": 0, "y": 0 },
      "visible_frames": [0, 300],
      "emitter": {
        "spawn_area": { "x": -700, "y": -450, "w": 1400, "h": 100 },
        "spawn_rate": 45.0, "max_particles": 130,
        "lifetime": [0.8, 1.3],
        "velocity": { "x": [-50, -20], "y": [700, 950] },
        "gravity": 0.0, "scale": [0.7, 1.1], "alpha": [220, 255],
        "rotation_speed": [-180, 180], "fade_out": false,
        "tint_options": ["#FFFFFF", "#E0F4FF", "#C8E8FF"]
      }
    },
    {
      "id": "hail_splash", "type": "emitter", "image": "_shared/splash_16.png",
      "z": 3, "blend": "normal", "pivot": "center", "offset": { "x": 0, "y": 330 },
      "visible_frames": [0, 300],
      "emitter": {
        "spawn_area": { "x": -650, "y": -20, "w": 1300, "h": 40 },
        "spawn_rate": 25.0, "max_particles": 40,
        "lifetime": [0.3, 0.5],
        "velocity": { "x": [-100, 100], "y": [-150, -80] },
        "gravity": 400.0, "scale": [0.6, 1.0], "alpha": [200, 255],
        "rotation_speed": [-180, 180], "fade_out": true,
        "tint_options": ["#FFFFFF", "#D0E8FF"]
      }
    }
  ],
  "default_binding": { "trigger": "weather.hail.enter" }
}